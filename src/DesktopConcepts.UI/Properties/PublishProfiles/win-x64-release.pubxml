<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: self-contained single-file for Windows x64.
  Output goes to: publish/win-x64/

  To publish from the repo root:
      dotnet publish src/DesktopConcepts.UI/DesktopConcepts.UI.csproj
             -p:PublishProfile=win-x64-release
             -c Release

  The output is a single DesktopConcepts.exe (~60-80 MB self-contained).
  Distribute that exe — no .NET runtime required on the target machine.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
