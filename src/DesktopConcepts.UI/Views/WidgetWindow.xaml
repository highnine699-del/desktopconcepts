<Window x:Class="DesktopConcepts.UI.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopConcepts"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="40" Top="40"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Right-click context menu on the widget itself (Task 2) -->
    <Window.ContextMenu>
        <ContextMenu Background="{StaticResource BrushSurface}"
                     BorderBrush="{StaticResource BrushBorder}"
                     Foreground="{StaticResource BrushText}">
            <MenuItem Header="Pin / Unpin"         Click="CtxPin_Click"/>
            <MenuItem Header="Copy concept"        Click="CtxCopy_Click"/>
            <Separator/>
            <MenuItem Header="AI Settings…"        Click="OpenSettings_Click"/>
            <Separator/>
            <MenuItem Header="Quit DesktopConcepts" Click="CtxQuit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1"
                        CenterX="160" CenterY="0"/>
    </Window.RenderTransform>

    <Border Background="{StaticResource BrushBackground}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}"
            Padding="0">

        <StackPanel>

            <!-- ══ SETUP CHOICE VIEW (first-run mode selection) ═════════
                 Shown before any other panel when IsFirstRun = true.
                 User picks Local or Cloud; code-behind sets AppSettings.Mode,
                 clears IsFirstRun, saves settings, then hides this panel and
                 continues the normal first-run / startup flow.
            ════════════════════════════════════════════════════════════ -->
            <Border x:Name="SetupChoiceView"
                    Visibility="Collapsed"
                    Padding="20,18">
                <StackPanel>

                    <TextBlock Text="Welcome to DesktopConcepts"
                               Foreground="{StaticResource BrushText}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="How do you want this to work?"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <!-- Option A: Local AI -->
                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusButton}"
                            Padding="14,12"
                            Margin="0,0,0,10"
                            Cursor="Hand"
                            MouseLeftButtonUp="SetupChooseLocal_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="🖥  Local AI"
                                           Foreground="{StaticResource BrushText}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"/>
                                <Border Background="{StaticResource BrushSecondary}"
                                        CornerRadius="4"
                                        Padding="5,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Free · Offline"
                                               Foreground="{StaticResource BrushBackground}"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Works fully offline. Downloads a model file once (a few GB) via your local AI server. No API key needed."
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Option B: Cloud AI -->
                    <Border Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusButton}"
                            Padding="14,12"
                            Margin="0,0,0,16"
                            Cursor="Hand"
                            MouseLeftButtonUp="SetupChooseCloud_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="☁  Cloud AI"
                                           Foreground="{StaticResource BrushText}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"/>
                                <Border Background="{StaticResource BrushPrimary}"
                                        CornerRadius="4"
                                        Padding="5,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Free · No API key needed"
                                               Foreground="{StaticResource BrushText}"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Works immediately — no account, no API key, no setup. Concepts are generated via a shared cloud service. A daily free limit applies; the app lets you know if it's reached."
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="You can change this later from AI Settings."
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Border>

            <!-- ══ COMPACT VIEW ══════════════════════════════════════════ -->
            <Border x:Name="CompactView"
                    Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Coloured category dot -->
                    <Ellipse Grid.Column="0" Width="8" Height="8"
                             Fill="{StaticResource BrushPrimary}"
                             VerticalAlignment="Top"
                             Margin="0,2,8,0"/>

                    <!-- Title + teaser — clicking expands -->
                    <StackPanel Grid.Column="1"
                                Cursor="Hand"
                                MouseLeftButtonUp="CompactView_Click">
                        <TextBlock x:Name="CompactTitle"
                                   Text="Loading…"
                                   Foreground="{StaticResource BrushText}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,2"/>
                        <TextBlock x:Name="CompactTeaser"
                                   Text="Today's concept"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="32"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Expand chevron -->
                    <TextBlock Grid.Column="2"
                               Text="▸"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="6,0,4,0"
                               Cursor="Hand"
                               MouseLeftButtonUp="CompactView_Click"/>

                    <!-- × close-to-tray — always visible, no hover required -->
                    <Button Grid.Column="3"
                            x:Name="CompactCloseButton"
                            Content="×"
                            ToolTip="Close to tray (right-click tray icon to fully quit)"
                            Cursor="Hand"
                            Click="CloseToTray_Click"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{StaticResource BrushTextMuted}"
                            FontSize="14"
                            FontFamily="{StaticResource FontPrimary}"
                            Padding="4,0"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       Padding="{TemplateBinding Padding}"
                                                       VerticalAlignment="Center"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ══ EXPANDED VIEW ═════════════════════════════════════════ -->
            <Border x:Name="ExpandedView"
                    Visibility="Collapsed"
                    Padding="16,12">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <StackPanel>

                    <!-- Header row: category tag + pin toggle + close-to-tray -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{StaticResource BrushPrimary}"
                                CornerRadius="4"
                                Padding="6,2"
                                HorizontalAlignment="Left">
                            <TextBlock x:Name="CategoryTag"
                                       Text="AI"
                                       Foreground="{StaticResource BrushText}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <ToggleButton Grid.Column="1"
                                      x:Name="PinButton"
                                      Style="{StaticResource ToggleButtonPin}"
                                      Content="📌"
                                      ToolTip="Pin (keeps this concept visible)"
                                      Checked="PinButton_Checked"
                                      Unchecked="PinButton_Unchecked"
                                      VerticalAlignment="Center"
                                      Margin="0,0,6,0"/>

                        <!-- × close-to-tray in Expanded view -->
                        <Button Grid.Column="2"
                                Content="×"
                                ToolTip="Close to tray (right-click tray icon to fully quit)"
                                Cursor="Hand"
                                Click="CloseToTray_Click"
                                FontSize="16"
                                FontFamily="{StaticResource FontPrimary}"
                                Foreground="{StaticResource BrushTextMuted}"
                                Padding="2,0"
                                VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock Text="{TemplateBinding Content}"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           FontSize="{TemplateBinding FontSize}"
                                                           Padding="{TemplateBinding Padding}"
                                                           VerticalAlignment="Center"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Concept title -->
                    <TextBlock x:Name="TitleText"
                               Text="Loading…"
                               Foreground="{StaticResource BrushText}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <!-- Concept explanation -->
                    <TextBlock x:Name="ExplanationText"
                               Text=""
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               LineHeight="20"
                               Margin="0,0,0,14"/>

                    <!-- Slot indicator: 1/3, 2/3, 3/3 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Center">
                        <Ellipse x:Name="Dot1" Width="7" Height="7" Margin="3,0"
                                 Fill="{StaticResource BrushPrimary}"/>
                        <Ellipse x:Name="Dot2" Width="7" Height="7" Margin="3,0"
                                 Fill="{StaticResource BrushBorder}"/>
                        <Ellipse x:Name="Dot3" Width="7" Height="7" Margin="3,0"
                                 Fill="{StaticResource BrushBorder}"/>
                    </StackPanel>

                    <!-- Action buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Read More"
                                Style="{StaticResource ButtonBase}"
                                Click="ReadMore_Click"/>

                        <Button Grid.Column="2"
                                Content="Copy"
                                Style="{StaticResource ButtonBase}"
                                Click="Copy_Click"/>

                        <Button Grid.Column="4"
                                Content="Next ▸"
                                Style="{StaticResource ButtonPrimary}"
                                Click="Next_Click"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ══ FIRST-RUN / DOWNLOAD VIEW ════════════════════════════ -->
            <Border x:Name="FirstRunView"
                    Visibility="Collapsed"
                    Padding="16,14">
                <StackPanel>

                    <TextBlock Text="Setting up local AI model"
                               Foreground="{StaticResource BrushText}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="Downloading the model for the first time. This is a one-time step."
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- Progress bar -->
                    <ProgressBar x:Name="DownloadProgress"
                                 Height="8"
                                 Minimum="0" Maximum="100" Value="0"
                                 Foreground="{StaticResource BrushPrimary}"
                                 Background="{StaticResource BrushBorder}"
                                 Margin="0,0,0,6"/>

                    <TextBlock x:Name="DownloadStatusText"
                               Text="Starting download…"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Margin="0,0,0,12"/>

                    <!-- Error panel (hidden until failure) -->
                    <Border x:Name="DownloadErrorPanel"
                            Visibility="Collapsed"
                            Background="{StaticResource BrushSurface}"
                            CornerRadius="6"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="DownloadErrorText"
                                       Foreground="{StaticResource BrushError}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"/>
                            <Button Content="Retry"
                                    Style="{StaticResource ButtonPrimary}"
                                    Click="DownloadRetry_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Cancel / skip to cloud -->
                    <Button Content="Use cloud mode instead"
                            Style="{StaticResource ButtonBase}"
                            Click="SkipToCloud_Click"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,0"/>

                </StackPanel>
            </Border>

            <!-- ══ ERROR VIEW (provider offline etc.) ═══════════════════ -->
            <Border x:Name="ErrorView"
                    Visibility="Collapsed"
                    Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Could not generate concept"
                               Foreground="{StaticResource BrushError}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="ErrorMessageText"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Retry"
                                Style="{StaticResource ButtonPrimary}"
                                Click="ErrorRetry_Click"/>
                        <Button Grid.Column="2" Content="AI Settings"
                                Style="{StaticResource ButtonBase}"
                                Click="OpenSettings_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ QUOTA VIEW (HTTP 429 / shared limit reached) ═════════
                 Shown instead of ErrorView when the proxy returns 429.
                 Not a real failure — just a friendly "try tomorrow" message.
            ═══════════════════════════════════════════════════════════════ -->
            <Border x:Name="QuotaView"
                    Visibility="Collapsed"
                    Padding="16,14">
                <StackPanel>
                    <TextBlock Text="Daily cloud limit reached"
                               Foreground="{StaticResource BrushAccent}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Today's free cloud allowance has been used up. Concepts will resume tomorrow automatically — no action needed."
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Switch to local mode shortcut -->
                        <Button Grid.Column="0"
                                Content="Use Local mode"
                                Style="{StaticResource ButtonBase}"
                                Click="OpenSettings_Click"
                                ToolTip="Open Settings to switch to Local AI mode"/>
                        <!-- Dismiss back to Compact -->
                        <Button Grid.Column="2"
                                Content="OK, got it"
                                Style="{StaticResource ButtonPrimary}"
                                Click="QuotaDismiss_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ TRAY HINT (shown once on first run, dismissed on click) ══
                 Teaches the user that × closes to tray, not fully quit.
                 Persisted via AppSettings.HasSeenTrayHint — never shows again.
            ═══════════════════════════════════════════════════════════════ -->
            <Border x:Name="TrayHintBanner"
                    Visibility="Collapsed"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="12,8"
                    Cursor="Hand"
                    MouseLeftButtonUp="TrayHint_Dismiss">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="💡"
                               FontSize="13"
                               VerticalAlignment="Top"
                               Margin="0,0,8,0"/>

                    <TextBlock Grid.Column="1"
                               Text="The × button closes to the system tray — the app keeps running. Right-click the tray icon to fully quit."
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Column="2"
                               Text="Got it"
                               Foreground="{StaticResource BrushPrimary}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </Grid>
            </Border>

        </StackPanel>
    </Border>
</Window>
