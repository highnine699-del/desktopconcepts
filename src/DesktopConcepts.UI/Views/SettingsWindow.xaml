<Window x:Class="DesktopConcepts.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DesktopConcepts — Settings"
        Width="420"
        SizeToContent="Height"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"    Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground"  Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"    Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="{StaticResource BrushText}"/>
            <Setter Property="Margin"      Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SettingsTextBox" TargetType="TextBox">
            <Setter Property="FontFamily"      Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Background"      Value="{StaticResource BrushSurface}"/>
            <Setter Property="Foreground"      Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="CaretBrush"      Value="{StaticResource BrushText}"/>
        </Style>
        <Style x:Key="SettingsPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontFamily"      Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Background"      Value="{StaticResource BrushSurface}"/>
            <Setter Property="Foreground"      Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="8,5"/>
        </Style>
        <Style x:Key="DayLabel" TargetType="TextBlock">
            <Setter Property="FontFamily"        Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"          Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground"        Value="{StaticResource BrushText}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"             Value="100"/>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BrushBackground}" Padding="20,18">
        <StackPanel>

            <!-- Title -->
            <TextBlock Text="Settings"
                       FontFamily="{StaticResource FontPrimary}"
                       FontSize="17" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushText}"
                       Margin="0,0,0,18"/>

            <!-- ══ AI MODE ═══════════════════════════════════════════════ -->
            <TextBlock Text="AI mode" Style="{StaticResource SectionHeader}"/>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Local card -->
                <Border x:Name="LocalCard" Grid.Column="0"
                        BorderThickness="2" CornerRadius="6" Padding="12,10"
                        Cursor="Hand" MouseLeftButtonUp="LocalCard_Click">
                    <StackPanel>
                        <TextBlock Text="🖥  Local AI"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushText}"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="Free · Offline · No API key"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </Border>

                <!-- Cloud card — zero-setup copy -->
                <Border x:Name="CloudCard" Grid.Column="2"
                        BorderThickness="2" CornerRadius="6" Padding="12,10"
                        Cursor="Hand" MouseLeftButtonUp="CloudCard_Click">
                    <StackPanel>
                        <TextBlock Text="☁  Cloud AI"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushText}"
                                   Margin="0,0,0,3"/>
                        <TextBlock Text="Free · No API key needed"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Foreground="{StaticResource BrushTextMuted}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══ CLOUD SECTION (visible only when Cloud is selected) ══ -->
            <Border x:Name="CloudSection" Visibility="Collapsed" Margin="0,8,0,0">
                <StackPanel>

                    <!-- Zero-setup info banner -->
                    <Border Background="{StaticResource BrushSurface}"
                            CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="✓  Works immediately — no setup required"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushSecondary}"
                                       Margin="0,0,0,4"/>
                            <TextBlock FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       TextWrapping="Wrap">
                                <Run Text="Concepts are generated via a shared cloud service — no account, no credit card. "/>
                                <Run Text="If the daily free limit is reached, the app will let you know and try again tomorrow."/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Advanced: use your own key (collapsed by default) -->
                    <Border x:Name="AdvancedSection"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0">
                        <StackPanel>

                            <!-- Expander header -->
                            <Border Cursor="Hand" MouseLeftButtonUp="AdvancedToggle_Click"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Advanced: use your own API key"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextMuted}"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="AdvancedChevron"
                                               Text="▸"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               Foreground="{StaticResource BrushTextMuted}"/>
                                </Grid>
                            </Border>

                            <!-- Advanced fields (collapsed until user expands) -->
                            <StackPanel x:Name="AdvancedFields" Visibility="Collapsed">

                                <TextBlock Style="{StaticResource FieldLabel}"
                                           TextWrapping="Wrap"
                                           Text="Override the shared service with your own provider. Your key is stored locally only and never sent anywhere except directly to the URL you enter below."
                                           Margin="0,0,0,10"/>

                                <!-- Base URL -->
                                <TextBlock Style="{StaticResource FieldLabel}" Text="API endpoint (base URL)"/>
                                <TextBox x:Name="AdvancedBaseUrl"
                                         Style="{StaticResource SettingsTextBox}"
                                         ToolTip="e.g. https://api.groq.com/openai/v1"
                                         Margin="0,0,0,10"/>

                                <!-- Model -->
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Model name"/>
                                <TextBox x:Name="AdvancedModel"
                                         Style="{StaticResource SettingsTextBox}"
                                         ToolTip="e.g. llama-3.3-70b-versatile"
                                         Margin="0,0,0,10"/>

                                <!-- API Key -->
                                <TextBlock Style="{StaticResource FieldLabel}" Text="API key"/>
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Foreground="{StaticResource BrushSecondary}"
                                           TextWrapping="Wrap"
                                           Text="Free to get — sign up at console.groq.com, no card required."
                                           Margin="0,0,0,6"/>

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="AdvancedApiKeyBox"
                                                 Grid.Column="0"
                                                 Style="{StaticResource SettingsPasswordBox}"
                                                 PasswordChar="●"
                                                 ToolTip="Paste your API key here"/>
                                    <Button Grid.Column="2"
                                            x:Name="ShowHideApiKey"
                                            Content="Show"
                                            Style="{StaticResource ButtonBase}"
                                            Padding="8,5"
                                            Click="ShowHideApiKey_Click"/>
                                </Grid>

                                <TextBox x:Name="AdvancedApiKeyPlain"
                                         Visibility="Collapsed"
                                         Style="{StaticResource SettingsTextBox}"
                                         Margin="0,0,0,4"/>

                                <!-- Clear advanced override -->
                                <Button Content="Clear — go back to shared service"
                                        Style="{StaticResource ButtonBase}"
                                        HorizontalAlignment="Left"
                                        Padding="10,4"
                                        Margin="0,4,0,0"
                                        Click="ClearAdvanced_Click"/>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Validation message (reused for all errors) -->
            <TextBlock x:Name="ApiKeyValidationText"
                       Foreground="{StaticResource BrushError}"
                       FontFamily="{StaticResource FontPrimary}"
                       FontSize="{StaticResource FontSizeSmall}"
                       Visibility="Collapsed"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"/>

            <!-- Separator -->
            <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,16,0,16"/>

            <!-- ══ WIDGET APPEARANCE ══════════════════════════════════════ -->
            <TextBlock Text="Widget appearance" Style="{StaticResource SectionHeader}"/>

            <!-- Opacity slider -->
            <TextBlock Style="{StaticResource FieldLabel}" Text="Widget opacity (transparency)"/>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="OpacitySlider"
                        Grid.Column="0"
                        Minimum="0.4"
                        Maximum="1.0"
                        TickFrequency="0.1"
                        IsSnapToTickEnabled="True"
                        Value="1.0"
                        Margin="0,0,8,0"
                        ValueChanged="OpacitySlider_ValueChanged"/>
                <TextBlock Grid.Column="1"
                           x:Name="OpacityValueText"
                           Text="100%"
                           FontFamily="{StaticResource FontPrimary}"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource BrushTextMuted}"
                           VerticalAlignment="Center"
                           MinWidth="40"/>
            </Grid>

            <!-- Pin behind desktop icons (experimental) -->
            <CheckBox x:Name="PinBehindIconsCheckBox"
                      Content="Pin behind desktop icons (experimental)"
                      Margin="0,0,0,4"
                      FontFamily="{StaticResource FontPrimary}"
                      FontSize="{StaticResource FontSizeBody}"
                      Foreground="{StaticResource BrushText}"/>
            <TextBlock Style="{StaticResource FieldLabel}"
                       TextWrapping="Wrap"
                       Text="May not work on all Windows versions and can occasionally require restarting the app if it stops behaving correctly."
                       Margin="0,0,0,12"/>

            <!-- Separator -->
            <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,16,0,16"/>

            <!-- ══ WEEKDAY TOPICS ════════════════════════════════════════ -->
            <TextBlock Text="Daily topic schedule" Style="{StaticResource SectionHeader}"/>
            <TextBlock Style="{StaticResource FieldLabel}"
                       Text="Each weekday covers a different subject area. Edit any day below."
                       TextWrapping="Wrap" Margin="0,0,0,10"/>

            <Grid x:Name="TopicsGrid">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"  Grid.Column="0" Text="Monday"    Style="{StaticResource DayLabel}"/>
                <TextBox   Grid.Row="0"  Grid.Column="1" x:Name="TopicMon" Style="{StaticResource SettingsTextBox}"/>
                <TextBlock Grid.Row="2"  Grid.Column="0" Text="Tuesday"   Style="{StaticResource DayLabel}"/>
                <TextBox   Grid.Row="2"  Grid.Column="1" x:Name="TopicTue" Style="{StaticResource SettingsTextBox}"/>
                <TextBlock Grid.Row="4"  Grid.Column="0" Text="Wednesday" Style="{StaticResource DayLabel}"/>
                <TextBox   Grid.Row="4"  Grid.Column="1" x:Name="TopicWed" Style="{StaticResource SettingsTextBox}"/>
                <TextBlock Grid.Row="6"  Grid.Column="0" Text="Thursday"  Style="{StaticResource DayLabel}"/>
                <TextBox   Grid.Row="6"  Grid.Column="1" x:Name="TopicThu" Style="{StaticResource SettingsTextBox}"/>
                <TextBlock Grid.Row="8"  Grid.Column="0" Text="Friday"    Style="{StaticResource DayLabel}"/>
                <TextBox   Grid.Row="8"  Grid.Column="1" x:Name="TopicFri" Style="{StaticResource SettingsTextBox}"/>
                <TextBlock Grid.Row="10" Grid.Column="0" Text="Saturday"  Style="{StaticResource DayLabel}"/>
                <TextBox   Grid.Row="10" Grid.Column="1" x:Name="TopicSat" Style="{StaticResource SettingsTextBox}"/>
                <TextBlock Grid.Row="12" Grid.Column="0" Text="Sunday"    Style="{StaticResource DayLabel}"/>
                <TextBox   Grid.Row="12" Grid.Column="1" x:Name="TopicSun" Style="{StaticResource SettingsTextBox}"/>
            </Grid>

            <!-- Separator -->
            <Border Height="1" Background="{StaticResource BrushBorder}" Margin="0,16,0,16"/>

            <!-- Save status + buttons -->
            <TextBlock x:Name="SaveStatusText"
                       Foreground="{StaticResource BrushSecondary}"
                       FontFamily="{StaticResource FontPrimary}"
                       FontSize="{StaticResource FontSizeSmall}"
                       Visibility="Collapsed"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,8"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"/>
                <Button Grid.Column="2" Content="Cancel"
                        Style="{StaticResource ButtonBase}" Padding="16,7"
                        Click="Cancel_Click"/>
                <Button Grid.Column="4" Content="Save"
                        Style="{StaticResource ButtonPrimary}" Padding="16,7"
                        Click="Save_Click"/>
            </Grid>

        </StackPanel>
    </Border>
</Window>
