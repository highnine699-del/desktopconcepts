<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        All animations: 200–250 ms, same cubic-ease-out curve.
        Reference these keys in code-behind via (Storyboard)FindResource("AnimXxx").
    -->

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>

    <!-- Fade in -->
    <Storyboard x:Key="AnimFadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.22"
                         EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

    <!-- Fade out -->
    <Storyboard x:Key="AnimFadeOut">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.22"
                         EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

    <!-- Scale in (used when widget expands) -->
    <Storyboard x:Key="AnimScaleIn">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.85" To="1" Duration="0:0:0.22"
                         EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.85" To="1" Duration="0:0:0.22"
                         EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.20"
                         EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

    <!-- Scale out (used when widget collapses) -->
    <Storyboard x:Key="AnimScaleOut">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="1" To="0.85" Duration="0:0:0.20"
                         EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="1" To="0.85" Duration="0:0:0.20"
                         EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0" Duration="0:0:0.18"
                         EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

    <!-- Slide in from bottom -->
    <Storyboard x:Key="AnimSlideInUp">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="20" To="0" Duration="0:0:0.25"
                         EasingFunction="{StaticResource EaseOut}"/>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.22"
                         EasingFunction="{StaticResource EaseOut}"/>
    </Storyboard>

</ResourceDictionary>
