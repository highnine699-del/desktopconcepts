<Window x:Class="Quire.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quire  ·  Settings"
        Width="580"
        Height="520"
        MinWidth="580"
        MinHeight="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <!-- ═══════════════════════════════════════════════════════════════════
         LOCAL STYLES
    ═══════════════════════════════════════════════════════════════════ -->
    <Window.Resources>

        <!-- Section header inside a content panel -->
        <Style x:Key="PanelSectionHeader" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"    Value="{StaticResource FontSizeBody}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Foreground"  Value="{StaticResource BrushText}"/>
            <Setter Property="Margin"      Value="0,0,0,12"/>
        </Style>

        <!-- Small muted field label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily"  Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"    Value="{StaticResource FontSizeSmall}"/>
            <Setter Property="Foreground"  Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="Margin"      Value="0,0,0,5"/>
        </Style>

        <!-- Day-label column in topic grid -->
        <Style x:Key="DayLabel" TargetType="TextBlock">
            <Setter Property="FontFamily"        Value="{StaticResource FontPrimary}"/>
            <Setter Property="FontSize"          Value="{StaticResource FontSizeBody}"/>
            <Setter Property="Foreground"        Value="{StaticResource BrushTextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"             Value="96"/>
        </Style>

        <!-- Dropdown-style row for topic day — surface bg, border, full width -->
        <Style x:Key="TopicRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

    </Window.Resources>

    <!-- ═══════════════════════════════════════════════════════════════════
         OUTER SHELL — true dark card, 12px radius, 1px border
    ═══════════════════════════════════════════════════════════════════ -->
    <Border Background="{StaticResource BrushBackground}"
            BorderBrush="{StaticResource BrushBorderStrong}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="168"/>
                <!-- Divider -->
                <ColumnDefinition Width="1"/>
                <!-- Content area -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 SIDEBAR
            ══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{StaticResource BrushSurface}"
                    CornerRadius="12,0,0,12">
                <DockPanel>

                    <!-- App title block -->
                    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,20">
                        <!-- Placeholder logo area — Q mark until final logo is set -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Border Width="22" Height="22"
                                    Background="{StaticResource BrushPrimary}"
                                    CornerRadius="6"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Q"
                                           Foreground="{StaticResource BrushText}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Quire"
                                       Foreground="{StaticResource BrushText}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Settings"
                                   Foreground="{StaticResource BrushTextSubtle}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSmall}"/>
                    </StackPanel>

                    <!-- Nav items -->
                    <StackPanel DockPanel.Dock="Top" Margin="10,0,10,0">

                        <Button x:Name="NavAI"
                                Style="{StaticResource NavButtonActive}"
                                Click="NavAI_Click"
                                Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✦" FontSize="11"
                                           Foreground="{StaticResource BrushPrimary}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="AI &amp; Content"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeNav}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavGeneral"
                                Style="{StaticResource NavButton}"
                                Click="NavGeneral_Click"
                                Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⊞" FontSize="11"
                                           Foreground="{StaticResource BrushTextSubtle}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="General"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeNav}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavAppearance"
                                Style="{StaticResource NavButton}"
                                Click="NavAppearance_Click"
                                Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="◑" FontSize="11"
                                           Foreground="{StaticResource BrushTextSubtle}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Appearance"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeNav}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="NavAbout"
                                Style="{StaticResource NavButton}"
                                Click="NavAbout_Click"
                                Margin="0,0,0,2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="ℹ" FontSize="11"
                                           Foreground="{StaticResource BrushTextSubtle}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="About"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeNav}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- Bottom: close button -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="10,0,10,14">
                        <Border Height="1"
                                Background="{StaticResource BrushBorder}"
                                Margin="0,0,0,10"/>
                        <Button Style="{StaticResource NavButton}"
                                Click="Cancel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✕" FontSize="10"
                                           Foreground="{StaticResource BrushTextSubtle}"
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Close"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeNav}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- Sidebar / content divider -->
            <Border Grid.Column="1"
                    Background="{StaticResource BrushBorder}"/>

            <!-- ══════════════════════════════════════════════════════════
                 CONTENT AREA — scrollable
            ══════════════════════════════════════════════════════════ -->
            <Border Grid.Column="2"
                    Background="{StaticResource BrushBackground}"
                    CornerRadius="0,12,12,0">
                <DockPanel>

                    <!-- ── Title bar row with window drag + close ──── -->
                    <Grid DockPanel.Dock="Top"
                          Height="46"
                          Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ContentPanelTitle"
                                   Grid.Column="0"
                                   Text="AI &amp; Content"
                                   Foreground="{StaticResource BrushText}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="20,0,0,0"/>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Margin="0,0,12,0">
                            <Button Content="—"
                                    Style="{StaticResource ButtonGhost}"
                                    FontSize="12"
                                    Padding="8,4"
                                    Click="MinimizeWindow_Click"
                                    Foreground="{StaticResource BrushTextSubtle}"/>
                            <Button Content="×"
                                    Style="{StaticResource ButtonClose}"
                                    FontSize="14"
                                    Padding="8,4"
                                    Click="Cancel_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Divider below title -->
                    <Border DockPanel.Dock="Top"
                            Height="1"
                            Background="{StaticResource BrushBorder}"/>

                    <!-- ── Save status bar (docked bottom) ─────────── -->
                    <Border DockPanel.Dock="Bottom"
                            x:Name="SaveBar"
                            Visibility="Collapsed"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,1,0,0"
                            Padding="20,10">
                        <TextBlock x:Name="SaveStatusText"
                                   Foreground="{StaticResource BrushSuccess}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"/>
                    </Border>

                    <!-- ── Validation / error message (docked bottom) ─ -->
                    <Border DockPanel.Dock="Bottom"
                            x:Name="ValidationBar"
                            Visibility="Collapsed"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,1,0,0"
                            Padding="20,10">
                        <TextBlock x:Name="ApiKeyValidationText"
                                   Foreground="{StaticResource BrushError}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- ── Save / Cancel footer ────────────────────── -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource BrushBackground}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="0,1,0,0"
                            Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"/>
                            <Button Grid.Column="1"
                                    Content="Cancel"
                                    Style="{StaticResource ButtonBase}"
                                    Padding="18,7"
                                    Click="Cancel_Click"/>
                            <Button Grid.Column="3"
                                    Content="Save changes"
                                    Style="{StaticResource ButtonPrimary}"
                                    Padding="18,7"
                                    Click="Save_Click"/>
                        </Grid>
                    </Border>

                    <!-- ── Scrollable panel host ────────────────────── -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0,0,0,0">
                        <StackPanel>

                            <!-- ══════════════════════════════════════
                                 PANEL: AI & CONTENT
                            ══════════════════════════════════════ -->
                            <StackPanel x:Name="PanelAI"
                                        Margin="20,18,20,4">

                                <!-- AI Mode -->
                                <TextBlock Text="AI mode"
                                           Style="{StaticResource PanelSectionHeader}"/>

                                <!-- Mode cards -->
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Local card -->
                                    <Border x:Name="LocalCard"
                                            Grid.Column="0"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,12"
                                            Cursor="Hand"
                                            AutomationProperties.Name="Choose Local AI mode"
                                            MouseLeftButtonUp="LocalCard_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="🖥"
                                                           FontSize="13"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="Local AI"
                                                           Foreground="{StaticResource BrushText}"
                                                           FontFamily="{StaticResource FontPrimary}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Free · Offline · No API key"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       FontFamily="{StaticResource FontPrimary}"
                                                       FontSize="{StaticResource FontSizeSmall}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Cloud card -->
                                    <Border x:Name="CloudCard"
                                            Grid.Column="2"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="14,12"
                                            Cursor="Hand"
                                            AutomationProperties.Name="Choose Cloud AI mode"
                                            MouseLeftButtonUp="CloudCard_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.85"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="☁"
                                                           FontSize="13"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="Cloud AI"
                                                           Foreground="{StaticResource BrushText}"
                                                           FontFamily="{StaticResource FontPrimary}"
                                                           FontSize="{StaticResource FontSizeBody}"
                                                           FontWeight="SemiBold"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Free · No API key needed"
                                                       Foreground="{StaticResource BrushTextMuted}"
                                                       FontFamily="{StaticResource FontPrimary}"
                                                       FontSize="{StaticResource FontSizeSmall}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Cloud section (visible when cloud mode selected) -->
                                <Border x:Name="CloudSection"
                                        Visibility="Collapsed"
                                        Margin="0,10,0,0">
                                    <StackPanel>

                                        <!-- Zero-setup info banner -->
                                        <Border Background="{StaticResource BrushSurface}"
                                                BorderBrush="{StaticResource BrushSuccess}"
                                                BorderThickness="0,0,0,0"
                                                CornerRadius="8"
                                                Padding="14,12"
                                                Margin="0,0,0,12">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                                    <TextBlock Text="✓"
                                                               Foreground="{StaticResource BrushSuccess}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Margin="0,0,7,0"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Text="Works immediately — no setup required"
                                                               Foreground="{StaticResource BrushSuccess}"
                                                               FontFamily="{StaticResource FontPrimary}"
                                                               FontSize="{StaticResource FontSizeBody}"
                                                               FontWeight="SemiBold"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock FontFamily="{StaticResource FontPrimary}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Foreground="{StaticResource BrushTextMuted}"
                                                           TextWrapping="Wrap">
                                                    <Run Text="Concepts are generated via a shared cloud service — no account, no credit card. "/>
                                                    <Run Text="If the daily free limit is reached, the app will let you know and try again tomorrow."/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>

                                        <!-- Advanced: your own API key -->
                                        <Border x:Name="AdvancedSection"
                                                Background="{StaticResource BrushSurface}"
                                                CornerRadius="8"
                                                Padding="14,12">
                                            <StackPanel>

                                                <!-- Expander header -->
                                                <Border Cursor="Hand"
                                                        MouseLeftButtonUp="AdvancedToggle_Click"
                                                        Margin="0,0,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="Advanced: use your own API key"
                                                                   FontFamily="{StaticResource FontPrimary}"
                                                                   FontSize="{StaticResource FontSizeSmall}"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BrushTextMuted}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1"
                                                                   x:Name="AdvancedChevron"
                                                                   Text="›"
                                                                   FontFamily="{StaticResource FontPrimary}"
                                                                   FontSize="14"
                                                                   Foreground="{StaticResource BrushTextSubtle}"
                                                                   VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Advanced fields -->
                                                <StackPanel x:Name="AdvancedFields"
                                                            Visibility="Collapsed"
                                                            Margin="0,12,0,0">

                                                    <TextBlock Style="{StaticResource FieldLabel}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,12"
                                                               Text="Override the shared service with your own provider. Your key is stored locally and never sent anywhere except the URL you enter."/>

                                                    <TextBlock Style="{StaticResource FieldLabel}"
                                                               Text="API endpoint (base URL)"/>
                                                    <TextBox x:Name="AdvancedBaseUrl"
                                                             Style="{StaticResource SettingsTextBox}"
                                                             ToolTip="e.g. https://api.groq.com/openai/v1"
                                                             Margin="0,0,0,12"/>

                                                    <TextBlock Style="{StaticResource FieldLabel}"
                                                               Text="Model name"/>
                                                    <TextBox x:Name="AdvancedModel"
                                                             Style="{StaticResource SettingsTextBox}"
                                                             ToolTip="e.g. llama-3.3-70b-versatile"
                                                             Margin="0,0,0,12"/>

                                                    <TextBlock Style="{StaticResource FieldLabel}"
                                                               Text="API key"/>
                                                    <TextBlock Style="{StaticResource FieldLabel}"
                                                               Foreground="{StaticResource BrushSecondary}"
                                                               TextWrapping="Wrap"
                                                               Text="Free to get — sign up at console.groq.com, no card required."
                                                               Margin="0,0,0,6"/>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <PasswordBox x:Name="AdvancedApiKeyBox"
                                                                     Grid.Column="0"
                                                                     Style="{StaticResource SettingsPasswordBox}"
                                                                     PasswordChar="●"
                                                                     ToolTip="Paste your API key here"/>
                                                        <Button Grid.Column="2"
                                                                x:Name="ShowHideApiKey"
                                                                Content="Show"
                                                                Style="{StaticResource ButtonBase}"
                                                                Padding="10,6"
                                                                Click="ShowHideApiKey_Click"/>
                                                    </Grid>
                                                    <TextBox x:Name="AdvancedApiKeyPlain"
                                                             Visibility="Collapsed"
                                                             Style="{StaticResource SettingsTextBox}"
                                                             Margin="0,0,0,12"/>

                                                    <Button Content="Clear — go back to shared service"
                                                            Style="{StaticResource ButtonBase}"
                                                            HorizontalAlignment="Left"
                                                            Padding="12,5"
                                                            Click="ClearAdvanced_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                    </StackPanel>
                                </Border>

                                <!-- Separator -->
                                <Border Style="{StaticResource SeparatorLine}"/>

                                <!-- Daily topic schedule -->
                                <TextBlock Text="Daily topic schedule"
                                           Style="{StaticResource PanelSectionHeader}"/>
                                <TextBlock Text="Each weekday covers a different subject area. Edit any day below."
                                           Style="{StaticResource FieldLabel}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>

                                <Grid x:Name="TopicsGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="5"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0"  Grid.Column="0" Text="Monday"    Style="{StaticResource DayLabel}"/>
                                    <TextBox   Grid.Row="0"  Grid.Column="1" x:Name="TopicMon" Style="{StaticResource SettingsTextBox}"/>
                                    <TextBlock Grid.Row="2"  Grid.Column="0" Text="Tuesday"   Style="{StaticResource DayLabel}"/>
                                    <TextBox   Grid.Row="2"  Grid.Column="1" x:Name="TopicTue" Style="{StaticResource SettingsTextBox}"/>
                                    <TextBlock Grid.Row="4"  Grid.Column="0" Text="Wednesday" Style="{StaticResource DayLabel}"/>
                                    <TextBox   Grid.Row="4"  Grid.Column="1" x:Name="TopicWed" Style="{StaticResource SettingsTextBox}"/>
                                    <TextBlock Grid.Row="6"  Grid.Column="0" Text="Thursday"  Style="{StaticResource DayLabel}"/>
                                    <TextBox   Grid.Row="6"  Grid.Column="1" x:Name="TopicThu" Style="{StaticResource SettingsTextBox}"/>
                                    <TextBlock Grid.Row="8"  Grid.Column="0" Text="Friday"    Style="{StaticResource DayLabel}"/>
                                    <TextBox   Grid.Row="8"  Grid.Column="1" x:Name="TopicFri" Style="{StaticResource SettingsTextBox}"/>
                                    <TextBlock Grid.Row="10" Grid.Column="0" Text="Saturday"  Style="{StaticResource DayLabel}"/>
                                    <TextBox   Grid.Row="10" Grid.Column="1" x:Name="TopicSat" Style="{StaticResource SettingsTextBox}"/>
                                    <TextBlock Grid.Row="12" Grid.Column="0" Text="Sunday"    Style="{StaticResource DayLabel}"/>
                                    <TextBox   Grid.Row="12" Grid.Column="1" x:Name="TopicSun" Style="{StaticResource SettingsTextBox}"/>
                                </Grid>

                                <Border Height="18"/>

                            </StackPanel>

                            <!-- ══════════════════════════════════════
                                 PANEL: GENERAL  (hidden by default)
                            ══════════════════════════════════════ -->
                            <StackPanel x:Name="PanelGeneral"
                                        Visibility="Collapsed"
                                        Margin="20,18,20,4">

                                <TextBlock Text="General"
                                           Style="{StaticResource PanelSectionHeader}"/>

                                <TextBlock Text="Auto-start with Windows"
                                           Style="{StaticResource FieldLabel}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Foreground="{StaticResource BrushText}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="Enable this from the Windows startup settings or Task Manager → Startup Apps."
                                           Style="{StaticResource FieldLabel}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16"/>

                                <Border Style="{StaticResource SeparatorLine}"/>

                                <TextBlock Text="Data &amp; storage"
                                           Style="{StaticResource PanelSectionHeader}"/>
                                <TextBlock TextWrapping="Wrap"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Margin="0,0,0,8">
                                    <Run Text="All data is stored in "/>
                                    <Run Text="%AppData%\Quire\" Foreground="{StaticResource BrushPrimary}" FontFamily="Consolas"/>
                                    <Run Text=" — Settings.json, History.md, and Logs. Nothing is stored outside this folder."/>
                                </TextBlock>
                                <Border Height="18"/>

                            </StackPanel>

                            <!-- ══════════════════════════════════════
                                 PANEL: APPEARANCE  (hidden by default)
                            ══════════════════════════════════════ -->
                            <StackPanel x:Name="PanelAppearance"
                                        Visibility="Collapsed"
                                        Margin="20,18,20,4">

                                <TextBlock Text="Widget appearance"
                                           Style="{StaticResource PanelSectionHeader}"/>

                                <!-- Opacity -->
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           Text="Opacity (transparency)"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="46"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="OpacitySlider"
                                            Grid.Column="0"
                                            Minimum="0.5"
                                            Maximum="1.0"
                                            TickFrequency="0.05"
                                            IsSnapToTickEnabled="True"
                                            Value="1.0"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0"
                                            AutomationProperties.Name="Widget opacity"
                                            ValueChanged="OpacitySlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1"
                                               x:Name="OpacityValueText"
                                               Text="100%"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               Foreground="{StaticResource BrushTextMuted}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"/>
                                    <!-- Reset to fully opaque (#18) -->
                                    <Button Grid.Column="3"
                                            Content="Reset"
                                            Style="{StaticResource ButtonGhost}"
                                            Padding="6,3"
                                            FontSize="{StaticResource FontSizeSmall}"
                                            ToolTip="Reset to 100% opacity"
                                            AutomationProperties.Name="Reset opacity to 100 percent"
                                            Click="OpacityReset_Click"/>
                                </Grid>
                                <TextBlock Text="Minimum 50% — lower values may make the widget hard to see."
                                           Style="{StaticResource FieldLabel}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16"/>

                                <Border Style="{StaticResource SeparatorLine}"/>

                                <!-- Pin behind desktop icons -->
                                <TextBlock Text="Desktop layer"
                                           Style="{StaticResource PanelSectionHeader}"/>

                                <CheckBox x:Name="PinBehindIconsCheckBox"
                                          Style="{StaticResource CheckBoxDark}"
                                          Content="Pin behind desktop icons (experimental)"
                                          Margin="0,0,0,6"/>
                                <TextBlock Style="{StaticResource FieldLabel}"
                                           TextWrapping="Wrap"
                                           Text="Places the widget in the Windows shell layer, behind desktop icons. May not work on all Windows versions. Restart the app if it stops behaving correctly."
                                           Margin="0,0,0,0"/>

                                <Border Height="18"/>

                            </StackPanel>

                            <!-- ══════════════════════════════════════
                                 PANEL: ABOUT  (hidden by default)
                            ══════════════════════════════════════ -->
                            <StackPanel x:Name="PanelAbout"
                                        Visibility="Collapsed"
                                        Margin="20,18,20,4">

                                <TextBlock Text="About Quire"
                                           Style="{StaticResource PanelSectionHeader}"/>

                                <Border Background="{StaticResource BrushSurface}"
                                        CornerRadius="8"
                                        Padding="16,14"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Quire"
                                                   Foreground="{StaticResource BrushText}"
                                                   FontFamily="{StaticResource FontPrimary}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="Desktop concepts. Every day."
                                                   Foreground="{StaticResource BrushTextMuted}"
                                                   FontFamily="{StaticResource FontPrimary}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   Margin="0,0,0,12"/>
                                        <Border Height="1"
                                                Background="{StaticResource BrushBorder}"
                                                Margin="0,0,0,12"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="6"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0"
                                                       Text="Version"
                                                       Foreground="{StaticResource BrushTextSubtle}"
                                                       FontFamily="{StaticResource FontPrimary}"
                                                       FontSize="{StaticResource FontSizeBody}"/>
                                            <TextBlock Grid.Row="0" Grid.Column="1"
                                                       x:Name="AboutVersionText"
                                                       Text="—"
                                                       Foreground="{StaticResource BrushText}"
                                                       FontFamily="{StaticResource FontPrimary}"
                                                       FontSize="{StaticResource FontSizeBody}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0"
                                                       Text="License"
                                                       Foreground="{StaticResource BrushTextSubtle}"
                                                       FontFamily="{StaticResource FontPrimary}"
                                                       FontSize="{StaticResource FontSizeBody}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1"
                                                       Text="MIT"
                                                       Foreground="{StaticResource BrushText}"
                                                       FontFamily="{StaticResource FontPrimary}"
                                                       FontSize="{StaticResource FontSizeBody}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Height="18"/>

                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                </DockPanel>
            </Border>

        </Grid>
    </Border>
</Window>
