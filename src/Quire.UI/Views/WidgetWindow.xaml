<Window x:Class="Quire.UI.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quire"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Left="40" Top="40"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <!-- Right-click context menu -->
    <Window.ContextMenu>
        <ContextMenu Background="{StaticResource BrushSurface}"
                     BorderBrush="{StaticResource BrushBorderStrong}"
                     BorderThickness="1"
                     Foreground="{StaticResource BrushText}">
            <MenuItem Header="Pin / Unpin"   Click="CtxPin_Click"/>
            <MenuItem Header="Copy concept"  Click="CtxCopy_Click"/>
            <Separator/>
            <MenuItem Header="Settings…"     Click="OpenSettings_Click"/>
            <Separator/>
            <MenuItem Header="Quit Quire"    Click="CtxQuit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <Window.RenderTransform>
        <ScaleTransform ScaleX="1" ScaleY="1" CenterX="160" CenterY="0"/>
    </Window.RenderTransform>

    <!-- ═══════════════════════════════════════════════════════════════════
         ROOT CARD — true dark bg, subtle border, 12px radius, no shadow
    ═══════════════════════════════════════════════════════════════════ -->
    <Border x:Name="RootBorder"
            Background="{StaticResource BrushBackground}"
            BorderBrush="{StaticResource BrushBorder}"
            BorderThickness="1"
            CornerRadius="{StaticResource RadiusCard}">

        <StackPanel>

            <!-- ══ UPDATE AVAILABLE BANNER ══════════════════════════════
                 Accent-yellow bar. Shown when RefreshScheduler fires.
            ══════════════════════════════════════════════════════════ -->
            <Border x:Name="UpdateBanner"
                    Visibility="Collapsed"
                    Background="{StaticResource BrushAccent}"
                    CornerRadius="10,10,0,0"
                    Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="UpdateBannerText"
                               Grid.Column="0"
                               Text="A new version is available."
                               Foreground="{StaticResource BrushBackground}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Grid.Column="1"
                            Content="Update Now"
                            Click="UpdateNow_Click"
                            Padding="8,4"
                            FontSize="{StaticResource FontSizeSmall}"
                            Background="{StaticResource BrushBackground}"
                            Foreground="{StaticResource BrushText}"
                            BorderThickness="0"
                            Style="{StaticResource ButtonBase}"/>
                    <Button Grid.Column="3"
                            Content="Later"
                            Click="UpdateLater_Click"
                            Padding="6,4"
                            FontSize="{StaticResource FontSizeSmall}"
                            Style="{StaticResource ButtonGhost}"
                            Foreground="{StaticResource BrushBackground}"/>
                </Grid>
            </Border>

            <!-- ══ SETUP CHOICE VIEW (first-run) ════════════════════════
                 Shown only when IsFirstRun = true.
            ══════════════════════════════════════════════════════════ -->
            <Border x:Name="SetupChoiceView"
                    Visibility="Collapsed"
                    Padding="18,16">
                <StackPanel>

                    <!-- Header -->
                    <TextBlock Text="Welcome to Quire"
                               Foreground="{StaticResource BrushText}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="How do you want this to work?"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               Margin="0,0,0,16"/>

                    <!-- Local AI card -->
                    <Border x:Name="SetupLocalCard"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorderStrong}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12"
                            Margin="0,0,0,8"
                            Cursor="Hand"
                            MouseLeftButtonUp="SetupChooseLocal_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="🖥  Local AI"
                                           Foreground="{StaticResource BrushText}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"/>
                                <Border Background="{StaticResource BrushSurface}"
                                        BorderBrush="{StaticResource BrushSecondary}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusBadge}"
                                        Padding="6,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Free · Offline"
                                               Foreground="{StaticResource BrushSecondary}"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeBadge}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Works fully offline. Downloads a model file once via your local AI server. No API key needed."
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Cloud AI card -->
                    <Border x:Name="SetupCloudCard"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushBorderStrong}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14,12"
                            Margin="0,0,0,14"
                            Cursor="Hand"
                            MouseLeftButtonUp="SetupChooseCloud_Click">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="☁  Cloud AI"
                                           Foreground="{StaticResource BrushText}"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"/>
                                <Border Background="{StaticResource BrushPrimaryMuted}"
                                        BorderBrush="{StaticResource BrushPrimary}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusBadge}"
                                        Padding="6,1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Free · No API key"
                                               Foreground="{StaticResource BrushPrimary}"
                                               FontFamily="{StaticResource FontPrimary}"
                                               FontSize="{StaticResource FontSizeBadge}"
                                               FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Works immediately — no account, no API key, no setup. A daily free limit applies."
                                       Foreground="{StaticResource BrushTextMuted}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="You can change this later in Settings."
                               Foreground="{StaticResource BrushTextSubtle}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ══ COMPACT VIEW ══════════════════════════════════════════
                 Default visible state. Small always-on-top badge.
                 Layout: [dot] [category · title + teaser] [›] [×]
            ══════════════════════════════════════════════════════════ -->
            <Border x:Name="CompactView"
                    Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Category dot — 6×6, indigo -->
                    <Ellipse Grid.Column="0"
                             Width="6" Height="6"
                             Fill="{StaticResource BrushPrimary}"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0"/>

                    <!-- Title + teaser -->
                    <StackPanel Grid.Column="1"
                                Cursor="Hand"
                                VerticalAlignment="Center"
                                MouseLeftButtonUp="CompactView_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CompactCategory"
                                       Text="Networking"
                                       Foreground="{StaticResource BrushPrimary}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXSmall}"
                                       FontWeight="SemiBold"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="CompactSlotIndicator"
                                       Text="1/3"
                                       Foreground="{StaticResource BrushTextSubtle}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeXSmall}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="CompactTitle"
                                   Text="Loading…"
                                   Foreground="{StaticResource BrushText}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,2"/>
                        <TextBlock x:Name="CompactTeaser"
                                   Text="Today's concept"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxHeight="30"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Expand chevron -->
                    <TextBlock Grid.Column="2"
                               Text="›"
                               Foreground="{StaticResource BrushTextSubtle}"
                               FontSize="16"
                               VerticalAlignment="Center"
                               Margin="8,0,4,0"
                               Cursor="Hand"
                               MouseLeftButtonUp="CompactView_Click"/>

                    <!-- × close-to-tray -->
                    <Button Grid.Column="3"
                            x:Name="CompactCloseButton"
                            Content="×"
                            ToolTip="Close to tray"
                            Click="CloseToTray_Click"
                            Foreground="{StaticResource BrushTextSubtle}"
                            FontSize="15"
                            VerticalAlignment="Center"
                            Style="{StaticResource ButtonClose}"
                            Padding="4,1"/>
                </Grid>
            </Border>

            <!-- ══ EXPANDED VIEW ═════════════════════════════════════════
                 Full concept card: category badge + slot dots + title +
                 explanation + three action buttons + pin + close.
            ══════════════════════════════════════════════════════════ -->
            <Border x:Name="ExpandedView"
                    Visibility="Collapsed"
                    Padding="16,14">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <StackPanel>

                    <!-- ── Header row ─────────────────────────────────── -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4"/>
                            <!-- slot dots mid -->
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Category badge pill -->
                        <Border Grid.Column="0"
                                Background="{StaticResource BrushPrimaryMuted}"
                                BorderBrush="{StaticResource BrushPrimary}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusBadge}"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CategoryTag"
                                       Text="Networking"
                                       Foreground="{StaticResource BrushPrimary}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeBadge}"
                                       FontWeight="SemiBold"/>
                        </Border>

                        <!-- Slot dots: 1/3 indicator -->
                        <Ellipse x:Name="Dot1" Grid.Column="1"
                                 Width="6" Height="6"
                                 Fill="{StaticResource BrushPrimary}"
                                 VerticalAlignment="Center"/>
                        <Ellipse x:Name="Dot2" Grid.Column="3"
                                 Width="6" Height="6"
                                 Fill="{StaticResource BrushBorderStrong}"
                                 VerticalAlignment="Center"/>
                        <Ellipse x:Name="Dot3" Grid.Column="5"
                                 Width="6" Height="6"
                                 Fill="{StaticResource BrushBorderStrong}"
                                 VerticalAlignment="Center"/>

                        <!-- Pin toggle -->
                        <ToggleButton Grid.Column="7"
                                      x:Name="PinButton"
                                      Style="{StaticResource ToggleButtonPin}"
                                      Content="📌"
                                      ToolTip="Pin — keeps this concept visible"
                                      Checked="PinButton_Checked"
                                      Unchecked="PinButton_Unchecked"
                                      VerticalAlignment="Center"/>

                        <!-- Close to tray -->
                        <Button Grid.Column="9"
                                Content="×"
                                ToolTip="Close to tray"
                                Click="CloseToTray_Click"
                                Foreground="{StaticResource BrushTextSubtle}"
                                FontSize="15"
                                VerticalAlignment="Center"
                                Style="{StaticResource ButtonClose}"
                                Padding="4,1"/>
                    </Grid>

                    <!-- ── Concept title ──────────────────────────────── -->
                    <TextBlock x:Name="TitleText"
                               Text="Loading…"
                               Foreground="{StaticResource BrushText}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,0,0,10"/>

                    <!-- ── Concept explanation ────────────────────────── -->
                    <TextBlock x:Name="ExplanationText"
                               Text=""
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               LineHeight="21"
                               Margin="0,0,0,16"/>

                    <!-- ── Divider ─────────────────────────────────────── -->
                    <Border Height="1"
                            Background="{StaticResource BrushBorder}"
                            Margin="0,0,0,12"/>

                    <!-- ── Action buttons ─────────────────────────────── -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Read More — icon + label -->
                        <Button Grid.Column="0"
                                Style="{StaticResource ButtonBase}"
                                Padding="0,7"
                                Click="ReadMore_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="↗" FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Read More"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Copy — icon + label -->
                        <Button Grid.Column="2"
                                Style="{StaticResource ButtonBase}"
                                Padding="0,7"
                                Click="Copy_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="⎘" FontSize="11"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,0,4,0"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Copy"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource BrushTextMuted}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Next — primary fill -->
                        <Button Grid.Column="4"
                                Style="{StaticResource ButtonPrimary}"
                                Padding="0,7"
                                Click="Next_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="Next"
                                           FontFamily="{StaticResource FontPrimary}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Foreground="{StaticResource BrushText}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text=" ›" FontSize="13"
                                           Foreground="{StaticResource BrushText}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ══ FIRST-RUN / DOWNLOAD VIEW ════════════════════════════ -->
            <Border x:Name="FirstRunView"
                    Visibility="Collapsed"
                    Padding="16,14">
                <StackPanel>

                    <TextBlock Text="Setting up local AI"
                               Foreground="{StaticResource BrushText}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeTitle}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="Downloading the model for the first time. One-time step."
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <!-- Slim progress bar -->
                    <ProgressBar x:Name="DownloadProgress"
                                 Style="{StaticResource ProgressBarPrimary}"
                                 Minimum="0" Maximum="100" Value="0"
                                 Margin="0,0,0,6"/>

                    <TextBlock x:Name="DownloadStatusText"
                               Text="Starting download…"
                               Foreground="{StaticResource BrushTextSubtle}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               Margin="0,0,0,12"/>

                    <!-- Error panel -->
                    <Border x:Name="DownloadErrorPanel"
                            Visibility="Collapsed"
                            Background="{StaticResource BrushSurface}"
                            BorderBrush="{StaticResource BrushError}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="DownloadErrorText"
                                       Foreground="{StaticResource BrushError}"
                                       FontFamily="{StaticResource FontPrimary}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,10"/>
                            <Button Content="Retry"
                                    Style="{StaticResource ButtonPrimary}"
                                    HorizontalAlignment="Left"
                                    Padding="14,6"
                                    Click="DownloadRetry_Click"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Use cloud mode instead"
                            Style="{StaticResource ButtonGhost}"
                            Click="SkipToCloud_Click"
                            HorizontalAlignment="Right"
                            Padding="8,5"
                            Foreground="{StaticResource BrushTextMuted}"/>

                </StackPanel>
            </Border>

            <!-- ══ ERROR VIEW ════════════════════════════════════════════ -->
            <Border x:Name="ErrorView"
                    Visibility="Collapsed"
                    Padding="16,14">
                <StackPanel>

                    <!-- Error icon + title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="⚠"
                                   Foreground="{StaticResource BrushError}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="Could not generate concept"
                                   Foreground="{StaticResource BrushError}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorMessageText"
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Retry"
                                Style="{StaticResource ButtonPrimary}"
                                Padding="0,7"
                                Click="ErrorRetry_Click"/>
                        <Button Grid.Column="2" Content="Settings"
                                Style="{StaticResource ButtonBase}"
                                Padding="0,7"
                                Click="OpenSettings_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ QUOTA VIEW (HTTP 429) ═════════════════════════════════ -->
            <Border x:Name="QuotaView"
                    Visibility="Collapsed"
                    Padding="16,14">
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="◑"
                                   Foreground="{StaticResource BrushAccent}"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Margin="0,0,7,0"/>
                        <TextBlock Text="Daily cloud limit reached"
                                   Foreground="{StaticResource BrushAccent}"
                                   FontFamily="{StaticResource FontPrimary}"
                                   FontSize="{StaticResource FontSizeTitle}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Today's free cloud allowance has been used. Concepts resume tomorrow automatically — no action needed."
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,14"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Use Local mode"
                                Style="{StaticResource ButtonBase}"
                                Padding="0,7"
                                Click="OpenSettings_Click"/>
                        <Button Grid.Column="2" Content="OK, got it"
                                Style="{StaticResource ButtonPrimary}"
                                Padding="0,7"
                                Click="QuotaDismiss_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══ TRAY HINT (shown once on first run) ═══════════════════ -->
            <Border x:Name="TrayHintBanner"
                    Visibility="Collapsed"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="14,9"
                    Cursor="Hand"
                    MouseLeftButtonUp="TrayHint_Dismiss">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="💡"
                               FontSize="12"
                               VerticalAlignment="Top"
                               Margin="0,1,8,0"/>

                    <TextBlock Grid.Column="1"
                               Text="The × button closes to the system tray — the app keeps running. Right-click the tray icon to fully quit."
                               Foreground="{StaticResource BrushTextMuted}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               TextWrapping="Wrap"/>

                    <TextBlock Grid.Column="2"
                               Text="Got it"
                               Foreground="{StaticResource BrushPrimary}"
                               FontFamily="{StaticResource FontPrimary}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </Grid>
            </Border>

        </StackPanel>
    </Border>
</Window>
